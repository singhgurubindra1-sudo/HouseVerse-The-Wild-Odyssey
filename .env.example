# Copy this file to .env.local and fill in the values from
# Supabase -> Project Settings -> API.
# Leave them empty to run Wildlands in DEMO MODE (in-memory sample data, no login setup needed).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: the public address of your site (used for login email links), e.g. https://wildlands.vercel.app
NEXT_PUBLIC_SITE_URL=
